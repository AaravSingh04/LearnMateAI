            "description": "Calls backend Google Gemini AI to analyze extracted text and generate summary, concepts, notes, and quiz."
          }
        },
        {
          "name": "Get Study Pack",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}/study-pack",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}", "study-pack"]
