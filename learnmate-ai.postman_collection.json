  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/dashboard/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard", "stats"]
            },
            "description": "Returns live database counts for total subjects, materials, study packs, and quiz attempts."
          }
        }
      ]
    },
    {
      "name": "Subjects",
      "item": [
        {
          "name": "List All Subjects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/subjects",
              "host": ["{{base_url}}"],
              "path": ["api", "subjects"]
            },
            "description": "Returns all subjects ordered alphabetically with material counts."
          }
        },
        {
          "name": "Create Subject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marketing Management\",\n  \"description\": \"Core concepts of marketing, branding, and customer segmentation.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/subjects",
              "host": ["{{base_url}}"],
              "path": ["api", "subjects"]
            },
            "description": "Creates a new subject. Rejects blank names or duplicate names."
          }
        },
        {
          "name": "Get Subject by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/subjects/{{subject_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subjects", "{{subject_id}}"]
            },
            "description": "Retrieves one subject or returns 404."
          }
        },
        {
          "name": "Update Subject",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marketing Strategy & Operations\",\n  \"description\": \"Updated course focus for the semester.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/subjects/{{subject_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subjects", "{{subject_id}}"]
            },
            "description": "Updates name and/or description of an existing subject."
          }
        },
        {
          "name": "Delete Subject",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/subjects/{{subject_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "subjects", "{{subject_id}}"]
            },
            "description": "Deletes the subject and cascade-deletes its materials, study packs, quiz records, and physical files."
          }
        }
      ]
    },
    {
      "name": "Materials",
      "item": [
        {
          "name": "Upload Material",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/subjects/{{subject_id}}/materials",
              "host": ["{{base_url}}"],
              "path": ["api", "subjects", "{{subject_id}}", "materials"]
