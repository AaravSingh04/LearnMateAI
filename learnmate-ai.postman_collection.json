        },
        {
          "name": "Get Material Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}"]
            },
            "description": "Retrieves metadata and processing status of a single material."
          }
        },
        {
          "name": "Delete Material",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}"]
            },
            "description": "Deletes the material, its study pack, questions, attempts, and disk file."
          }
        }
      ]
    },
    {
      "name": "Study Packs",
      "item": [
        {
          "name": "Generate Study Pack",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
