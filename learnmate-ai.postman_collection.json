            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"question_id\": 1,\n      \"selected_option_index\": 0\n    },\n    {\n      \"question_id\": 2,\n      \"selected_option_index\": 2\n    }\n  ]\n}"
