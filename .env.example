# LearnMate AI - Environment Configuration Example
# Copy this file to .env and insert your real Gemini API key for AI study-pack generation.

# Google Gemini API Configuration (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
